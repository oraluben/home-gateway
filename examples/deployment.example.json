{
  "connection": {
    "Address": "192.168.50.201",
    "User": "gateway",
    "PublicKey": "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY",
    "AuthorizedKeysFile": "~/.ssh/authorized_keys"
  },
  "network": {
    "address": "192.168.50.201/24",
    "gateway": "192.168.50.1",
    "dns": [
      "192.168.50.1"
    ]
  },
  "timezone": "Asia/Shanghai",
  "vpn_profiles_pass": "vpn/profiles",
  "vpn_profile": "vpn2",
  "secrets": {
    "subscription_url": "home-gateway/subscription-url",
    "controller": "home-gateway/controller"
  },
  "runtime": {
    "network": {
      "interface": "eth0",
      "clients": [
        "192.168.50.0/24",
        "192.168.60.0/24"
      ]
    },
    "clash": {
      "enabled": true,
      "attempts": 3
    },
    "vpn": {
      "enabled": true,
      "interface": "vpn0",
      "attempts": 4,
      "retry_delay_seconds": 15,
      "retry_max_delay_seconds": 60,
      "stable_reset_seconds": 600,
      "reconnect_timeout": 30
    },
    "mihomo": {
      "mode": "rule",
      "external-controller": "192.168.50.201:9090",
      "external-ui": "ui",
      "unified-delay": true,
      "profile": {
        "store-selected": true
      }
    },
    "subscription": {
      "user_agent": "clash-verge",
      "interval_seconds": 86400,
      "enabled": true,
      "required_groups": [
        "AI",
        "Main"
      ],
      "fallback_filters": {
        "AI": "US|美国",
        "Main": "HK|香港"
      }
    }
  },
  "host": {
    "backend": "hyperv",
    "hyperv": {
      "VMName": "HomeGateway",
      "SwitchName": "HomeGateway-LAN",
      "PhysicalAdapterGuid": "00000000-0000-0000-0000-000000000000",
      "MacAddress": "00155D500001",
      "MemoryMB": 2048,
      "ProcessorCount": 2,
      "DiskSizeGB": 16,
      "BaseImage": "https://cloud-images.ubuntu.com/releases/noble/release-20260926/ubuntu-24.04-server-cloudimg-amd64.img"
    }
  }
}
